# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telangana_realty
DB_SSL=false

# Authentication
JWT_SECRET=super-secret-telangana-realty-jwt-key-2026
JWT_EXPIRES_IN=7d

# File Storage (AWS S3 or Local)
STORAGE_DRIVER=local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=telangana-realty-documents
UPLOAD_DIR=./uploads

# Messaging & Alerts (Twilio / Wati WhatsApp Gateway)
NOTIFICATION_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=

# Google Maps API
GOOGLE_MAPS_API_KEY=

# Internal Team Alerts
ADMIN_ALERT_PHONE=+919876543210
ADMIN_ALERT_WHATSAPP=+919876543210
FRONTEND_URL=http://localhost:3000
