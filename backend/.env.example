# =============================================================================
# Telangana Real-Estate Brokerage Platform — Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required credentials.
# NEVER commit the real .env file with sensitive credentials to version control.

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000

# --- DATABASE CONFIGURATION (PostgreSQL) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Points to existing local PostgreSQL database: real_estate_brokerage
DATABASE_URL=postgresql://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/real_estate_brokerage
DB_SSL=false

# --- AUTHENTICATION & JWT SECURITY ---
# Minimum 32-character high-entropy secret for HMAC-SHA256 token signing
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_for_production
JWT_EXPIRES_IN=7d

# --- FILE STORAGE ADAPTER ---
# Options: 'local' (filesystem in uploadDir) | 's3' (AWS S3)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# AWS S3 Configuration (Required only when STORAGE_DRIVER=s3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=telangana-realty-documents

# --- NOTIFICATION & MESSAGING GATEWAY ---
# Options: 'mock' (simulated/console logs) | 'twilio' | 'wati'
NOTIFICATION_PROVIDER=mock

# Twilio Configuration (Required when NOTIFICATION_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Wati Configuration (Required when NOTIFICATION_PROVIDER=wati)
WATI_API_ENDPOINT=https://live-server-api.wati.io
WATI_ACCESS_TOKEN=your_wati_access_token

# --- INTERNAL TEAM ALERT DISPATCH ---
ADMIN_ALERT_PHONE=+919876543210
ADMIN_ALERT_WHATSAPP=+919876543210

# --- GOOGLE MAPS API ---
# Used for geocoding addresses and Distance Matrix calculations
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
