 md:pb-0 md:pr-8 space-y-3","children":[["$","span",null,{"className":"text-[11px] font-mono uppercase tracking-widest text-[#8C653E] block","children":"The Core Manifesto"}],["$","blockquote",null,{"className":"font-serif text-2xl text-[#191512] leading-snug italic","children":"“True luxury in real estate is unconditional legal certainty.”"}],["$","p",null,{"className":"text-xs text-[#8C653E] pt-2","children":"— Directorate of Conveyancing & Diligence"}]]}],["$","div",null,{"className":"md:col-span-8 space-y-5 text-sm sm:text-base text-[#4A423A] font-light leading-relaxed","children":[["$","p",null,{"children":"తెలంగాణ రియల్ ఎస్టేట్ మార్కెట్‌లో కొనుగోలుదారులు మరియు అమ్మకందారులు ఎదుర్కొనే ప్రధాన సమస్య అస్పష్టమైన రికార్డులు మరియు అవాంఛనీయ మధ్యవర్తుల గందరగోళం. మేము ఈ సమస్యకు శాశ్వత పరిష్కారంగా చట్టపరమైన స్పష్టతతో కూడిన ప్రొఫెషనల్ బ్రోకరేజ్ సేవలను అందిస్తున్నాము."}],["$","p",null,{"children":"ప్రతి ప్రాపర్టీ లిస్టింగ్‌కు ముందు ధరణి పోర్టల్ రికార్డులు, 30 ఏళ్ల నిరభ్యంతర ఈసీ, లింక్ డాక్యుమెంట్లు మరియు లేఅవుట్ అనుమతులను మా న్యాయవాదుల బృందం క్షుణ్ణంగా పరిశీలిస్తుంది. పూర్తి క్లియరెన్స్ లభించిన తర్వాతే బ్రోకరేజ్ డీల్ ప్రాసెస్ ప్రారంభమవుతుంది."}]]}]]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-3 gap-5 pt-8 border-t border-[#E8E2D9]","children":[["$","div",null,{"className":"p-5 rounded-xl bg-[#FAF8F5] border border-[#E8E2D9] space-y-3 hover:border-[#8C653E]/40 transition-colors","children":[["$","div",null,{"className":"flex items-center justify-between","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-scale w-5 h-5 text-[#8C653E]","children":[["$","path","7g6ntu",{"d":"m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"}],["$","path","ijws7r",{"d":"m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"}],["$","path","1b0cd5",{"d":"M7 21h10"}],["$","path","108xh3",{"d":"M12 3v