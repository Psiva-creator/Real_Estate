13:{"id":"PROP-HYD-002","title":"Gated Villa Plot in Shankarpally Growth Belt","titleTe":"శంకర్‌పల్లి రోడ్‌లో గేటెడ్ విల్లా ప్లాట్","description":"Premium east-facing residential plot in HMDA sanctioned gated layout. Direct access to 100ft road, clear link records from 1985, spot Dharani passbook mutation guaranteed.","descriptionTe":"HMDA అనుమతి పొందిన లేఅవుట్‌లో తూర్పు ముఖపు రెసిడెన్షియల్ ప్లాట్. 100 అడుగుల రోడ్డు కనెక్టివిటీ, 1985 నుండి క్లియర్ లింక్ డాక్యుమెంట్లు మరియు స్పాట్ రిజిస్ట్రేషన్.","type":"LAND","status":"VERIFIED","location":"$14","pricing":"$15","land":"$16","mainImage":"https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1000&q=80","galleryImages":"$11","verifiedDocsCount":13,"totalDocsRequired":13,"isFeatured":true,"isOrrCorridor":true,"hmdaApproved":true,"dharaniApproved":true}
